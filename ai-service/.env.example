# ==============================================================================
# AI Provider Configuration
# ==============================================================================

# Primary AI Provider Strategy
# Must be one of: gemini, groq, openai, anthropic, deepseek, huggingface (case-insensitive)
PRIMARY_AI_PROVIDER=gemini

# Fallback AI Provider Strategy
# Comma-separated list of fallback providers in priority order.
# Whitespace and case-sensitivity are ignored. Duplicate names are removed.
# Example: groq, openai, anthropic
FALLBACK_AI_PROVIDERS=groq,openai,anthropic

# ------------------------------------------------------------------------------
# API Keys (Placeholders)
# At least the PRIMARY_AI_PROVIDER API key must be configured with a valid value.
# Configured fallback providers without a valid key will be filtered out at startup.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
HUGGINGFACE_TOKEN=your_huggingface_token

# ------------------------------------------------------------------------------
# Model Overrides (Optional)
# If omitted, sensible default models will be used.
# ------------------------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
DEEPSEEK_MODEL=deepseek-chat
HUGGINGFACE_MODEL=meta-llama/Llama-3-8b-instruct

# ==============================================================================
# Service Configuration
# ==============================================================================
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
REDIS_URL=
