  <!-- ================================================================= -->
  <!-- Workflow Intent: Project Submissions                              -->
  <!-- ================================================================= -->
  <category>
    <pattern>HOW DO I SUBMIT A PROJECT</pattern>
    <template>
      To submit a project:
      1. Ensure your repository (GitHub/GitLab) is public or shared with your mentors.
      2. Include a comprehensive README and project demo video link.
      3. Navigate to Tasks or Assessments in InternOps.
      4. Submit the repository URL and deployment link for final review.
    </template>
  </category>

  <category>
    <pattern>HOW TO SUBMIT PROJECT</pattern>
