  <!-- ================================================================= -->
  <!-- Workflow Intent: Viewing Assigned Tasks                           -->
  <!-- ================================================================= -->
  <category>
    <pattern>WHERE CAN I SEE MY ASSIGNED TASKS</pattern>
    <template>
      You can view all your assigned tasks by clicking on Tasks in the left sidebar navigation, or directly from the My Active Tasks widget on your main Dashboard.
    </template>
  </category>

