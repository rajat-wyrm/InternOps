<?xml version="1.0" encoding="UTF-8"?>
<aiml version="1.0.1">

  <!-- ================================================================= -->
  <!-- Workflow Intent: Submitting Work / Assignments / Proofs           -->
  <!-- ================================================================= -->
  <category>
    <pattern>HOW DO I SUBMIT MY WORK</pattern>
    <template>
      <random>
        <li>You can submit your work through InternOps: 1. Go to Tasks in the sidebar. 2. Select your assigned task. 3. Click 'Upload Proof' or 'Submit Work'. 4. Attach your screenshot/link/file and click Submit for verification by your Captain or Team Lead.</li>
        <li>To submit work: Navigate to Tasks in InternOps, open the specific task or assignment, attach the required proof (screenshot/repository link/document), and click Submit. Your submission will be queued for review.</li>
      </random>
    </template>
  </category>

  <category>
    <pattern>HOW CAN I SUBMIT MY WORK</pattern>
    <template><srai>HOW DO I SUBMIT MY WORK</srai></template>
  </category>

  <category>
    <pattern>WHERE DO I SUBMIT MY ASSIGNMENT</pattern>
    <template><srai>HOW DO I SUBMIT MY WORK</srai></template>
  </category>

  <category>
    <pattern>HOW CAN I SUBMIT MY TASK</pattern>
    <template><srai>HOW DO I SUBMIT MY WORK</srai></template>
  </category>

  <category>
    <pattern>WHERE CAN I UPLOAD MY WORK</pattern>
    <template><srai>HOW DO I SUBMIT MY WORK</srai></template>
  </category>

