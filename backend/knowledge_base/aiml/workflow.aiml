  </category>

  <!-- ================================================================= -->
  <!-- Workflow Intent: Contacting Mentor                                -->
  <!-- ================================================================= -->
  <category>
    <pattern>HOW DO I CONTACT MY MENTOR</pattern>
    <template>
      You can contact your mentor by:
      1. Finding their contact email and chat handle in the Team section of InternOps.
      2. Messaging them on the official team Slack / Discord / WhatsApp group.
      3. Requesting a 1:1 meeting using the Meetings section in InternOps.
    </template>
  </category>

  <category>
    <pattern>HOW TO CONTACT MENTOR</pattern>
    <template><srai>HOW DO I CONTACT MY MENTOR</srai></template>
