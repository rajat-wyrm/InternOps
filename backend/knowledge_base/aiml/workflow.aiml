  <!-- ================================================================= -->
  <!-- Workflow Intent: Updating Task Status                             -->
  <!-- ================================================================= -->
  <category>
    <pattern>HOW DO I UPDATE MY TASK STATUS</pattern>
    <template>
      To update task status: Go to Tasks in InternOps, open your active task, and change the status dropdown (e.g., In Progress, Blocked, or Completed). When completing a task that requires proof, upload the required screenshot or link.
    </template>
  </category>

  <category>
    <pattern>HOW TO UPDATE TASK STATUS</pattern>
    <template><srai>HOW DO I UPDATE MY TASK STATUS</srai></template>
  </category>

  <category>
    <pattern>HOW DO I CHANGE TASK STATUS</pattern>
    <template><srai>HOW DO I UPDATE MY TASK STATUS</srai></template>
  </category>

  <category>
