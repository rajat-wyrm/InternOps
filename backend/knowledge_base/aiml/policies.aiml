  <!-- ================================================================= -->
  <!-- Policy Intent: Working Hours                                      -->
  <!-- ================================================================= -->
  <category>
    <pattern>WHAT ARE THE WORKING HOURS</pattern>
    <template>
      Standard working hours are Monday through Friday, 9:30 AM to 6:30 PM IST (with a 1-hour lunch break). Core collaboration hours are 11:00 AM to 5:00 PM IST when all team members are expected to be online for standups and syncs. Flexible hours can be coordinated with your Team Lead.
    </template>
  </category>

