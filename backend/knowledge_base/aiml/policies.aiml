  <!-- ================================================================= -->
  <!-- Policy Intent: Attendance Policy                                  -->
  <!-- ================================================================= -->
  <category>
    <pattern>WHAT IS THE ATTENDANCE POLICY</pattern>
    <template>
      <random>
        <li>Our attendance policy requires interns to mark attendance daily through the InternOps portal under Attendance. You must maintain at least 80% cumulative attendance to remain eligible for internship completion and certification. If you are unable to attend, notify your Team Lead in advance.</li>
        <li>Attendance Policy: Daily attendance must be logged via InternOps under the Attendance section. Minimum 80% attendance is mandatory for certification. In case of unexpected absence, inform your Captain/TL before 10:00 AM.</li>
      </random>
    </template>
  </category>

  <category>
    <pattern>ATTENDANCE POLICY</pattern>
    <template><srai>WHAT IS THE ATTENDANCE POLICY</srai></template>
  </category>

