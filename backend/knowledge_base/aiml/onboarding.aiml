  </category>

  <!-- ================================================================= -->
  <!-- Onboarding Intent: Completing Onboarding Checklist                -->
  <!-- ================================================================= -->
  <category>
    <pattern>HOW DO I COMPLETE MY ONBOARDING</pattern>
    <template>
      To complete your onboarding:
      1. Navigate to the Onboarding tab in InternOps.
      2. Mark each checklist item as completed once finished (profile setup, doc upload, orientation call).
      3. Once all items are checked off, notify your mentor or Team Lead for final clearance.
    </template>
  </category>

  <category>
    <pattern>HOW TO COMPLETE ONBOARDING</pattern>
    <template><srai>HOW DO I COMPLETE MY ONBOARDING</srai></template>
