  <!-- ================================================================= -->
  <!-- Onboarding Intent: Mentor Assignment                              -->
  <!-- ================================================================= -->
  <category>
    <pattern>WHO IS MY MENTOR</pattern>
    <template>
      Your mentor / Team Lead is displayed on your InternOps dashboard and under the Team section. If you don't see an assigned mentor, please contact your Captain or HR coordinator.
    </template>
  </category>

