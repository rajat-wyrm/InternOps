  <!-- ================================================================= -->
  <!-- Onboarding Intent: Onboarding Instructions                        -->
  <!-- ================================================================= -->
  <category>
    <pattern>WHERE CAN I FIND ONBOARDING INSTRUCTIONS</pattern>
    <template>
      You can find onboarding instructions in the InternOps portal under the Onboarding section on your navigation sidebar, in the welcome email sent to your registered address, and in the beginner's guide shared in the team workspace.
    </template>
  </category>

  <category>
    <pattern>WHERE ARE THE ONBOARDING INSTRUCTIONS</pattern>
    <template><srai>WHERE CAN I FIND ONBOARDING INSTRUCTIONS</srai></template>
  </category>

  <category>
    <pattern>HOW TO FIND ONBOARDING INSTRUCTIONS</pattern>
    <template><srai>WHERE CAN I FIND ONBOARDING INSTRUCTIONS</srai></template>
  </category>

