{
  "name": "internops-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node src/app.js",
    "start": "cross-env NODE_ENV=production node src/app.js",
    "migrate": "node src/db/migrate.js",
    "migrate:fix": "node src/db/migrate.js --fix-checksums",
    "seed": "node seeds/seed.js",
    "test": "cross-env NODE_ENV=test LOG_LEVEL=silent jest --config jest.config.js --runInBand --testTimeout=60000",
    "test:debug": "cross-env NODE_ENV=test LOG_LEVEL=silent jest --config jest.config.js --runInBand --detectOpenHandles --testTimeout=60000",
    "test:coverage": "cross-env NODE_ENV=test LOG_LEVEL=silent jest --config jest.config.js --runInBand --coverage --testTimeout=60000",
    "format": "prettier --write .",
    "lint": "eslint . && node scripts/lint-modules.js",
    "lint:modules": "node scripts/lint-modules.js",
    "lint:db": "node scripts/lint-db.js",
    "generate:module": "node scripts/generate-module.js"
  },
  "dependencies": {
    "@fastify/compress": "^9.0.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@google/genai": "^2.13.0",
    "@google/generative-ai": "^0.24.1",
    "argon2": "^0.44.0",
    "bullmq": "^6.1.2",
    "cheerio": "^1.2.0",
    "color-name": "^2.1.1",
    "cross-env": "^10.1.0",
    "dijkstrajs": "^1.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.5.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "p-limit": "^3.1.0",
    "p-try": "^2.2.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.21.0",
    "pino": "^9.1.0",
    "pino-pretty": "^11.2.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "^6.0.0",
    "sanitize-html": "^2.17.5",
    "socket.io": "^4.8.3",
    "uuid": "11.1.1",
    "zod": "^3.25.28",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "eslint": "^9.16.0",
    "jest": "^30.4.2",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2"
  }
}
